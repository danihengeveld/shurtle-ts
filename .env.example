# Copy to .env.development.local for local development (see "Local development" in the README).
# `next dev` reads .env.development.local before .env.local, and so do `pnpm db:push` and
# `pnpm db:seed`. Set every variable here: anything left out falls back to .env.local.

# Postgres from compose.yaml (`docker compose up -d`). The app reaches it through the WebSocket
# proxy on port 54321; drizzle-kit and the seed connect directly.
POSTGRES_URL="postgres://shurtle:shurtle@localhost:54320/shurtle"

# Clerk: the keys of a development instance (pk_test_/sk_test_), never the production ones.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Upstash, for rate limiting. Optional locally: left empty, rate limiting fails open (it logs an
# error and allows the request). For the local Redis from `docker compose --profile redis up -d`:
#   KV_REST_API_URL="http://localhost:54379"
#   KV_REST_API_TOKEN="shurtle-local-token"
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Bearer token for /api/cron/archive-expired.
CRON_SECRET="local-cron-secret"
